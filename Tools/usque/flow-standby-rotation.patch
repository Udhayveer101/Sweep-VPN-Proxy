diff --git a/api/standby.go b/api/standby.go
new file mode 100644
index 0000000..c1f41ae
--- /dev/null
+++ b/api/standby.go
@@ -0,0 +1,226 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"math/rand"
+	"net"
+	"sync"
+	"time"
+
+	connectip "github.com/Diniboy1123/connect-ip-go"
+	"github.com/Diniboy1123/usque/internal"
+	"github.com/quic-go/quic-go/http3"
+)
+
+// errFlowRotate retires a MASQUE session that is still healthy.
+//
+// The ISP on the target network sweeps established TCP flows and tears down
+// every long-lived one at once (measured 2026-09-15: Google, Apple and
+// Cloudflare TLS flows all stalled in the same second while ICMP kept
+// flowing). Every previous mitigation was reactive - PINGs, wedge detection,
+// always-reconnect - so the best case was still "notice the kill, rebuild,
+// stall for a second or two". Rotating on a timer means the flow never gets
+// old enough to be swept, and because the replacement is already handshaken
+// the handover costs no downtime.
+var errFlowRotate = errors.New("rotating MASQUE flow before it ages out")
+
+// standbyWaitRetry is how long a due rotation waits when no standby is ready
+// yet. Rotating without a warm replacement would reintroduce the very gap
+// this exists to remove, so a rotation is always deferred, never forced.
+const standbyWaitRetry = 5 * time.Second
+
+// tunnelSession owns the three handles that make up one MASQUE session.
+// Grouping them keeps a promoted standby impossible to half-close: the
+// relay-era bug (a retired adapter arming a second tunnel) came from exactly
+// that kind of split ownership.
+type tunnelSession struct {
+	udpConn *net.UDPConn
+	tr      *http3.Transport
+	ipConn  *connectip.Conn
+}
+
+// Close releases every handle the session owns. Safe on a partially dialed
+// session, so failure paths can call it unconditionally.
+func (s *tunnelSession) Close() {
+	if s == nil {
+		return
+	}
+	if s.ipConn != nil {
+		_ = s.ipConn.Close()
+	}
+	if s.tr != nil {
+		_ = s.tr.Close()
+	}
+	if s.udpConn != nil {
+		_ = s.udpConn.Close()
+	}
+}
+
+// dialSession establishes one MASQUE session and returns it ready to pump.
+// It is the connect half of MaintainTunnel's loop, extracted so the standby
+// dialer can run the identical path off the critical path.
+func dialSession(ctx context.Context, cfg MaintainTunnelConfig) (*tunnelSession, error) {
+	udpConn, tr, ipConn, rsp, err := ConnectTunnel(
+		ctx,
+		cfg.TLSConfig,
+		internal.DefaultQuicConfig(cfg.KeepalivePeriod, cfg.InitialPacketSize),
+		internal.ConnectURI,
+		cfg.Endpoint,
+		cfg.UseHTTP2,
+	)
+	sess := &tunnelSession{udpConn: udpConn, tr: tr, ipConn: ipConn}
+	if err != nil {
+		sess.Close()
+		return nil, err
+	}
+	if rsp.StatusCode != 200 {
+		sess.Close()
+		return nil, fmt.Errorf("tunnel connection failed: %s", rsp.Status)
+	}
+	return sess, nil
+}
+
+// fillStandby keeps one warm session parked in ch until ctx ends.
+//
+// A standby makes fast kill detection safe. Tightening the keepalive alone was
+// measured to be worse than leaving it (-k 2s produced more false positives
+// than -k 5s) because every false positive cost a full rebuild. With a warm
+// session waiting, a false positive costs a promotion instead, so detection
+// can be aggressive.
+func fillStandby(ctx context.Context, cfg MaintainTunnelConfig, ch chan *tunnelSession) {
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		if len(ch) > 0 {
+			// Already warm; wait for a promotion to drain it.
+			if err := sleepCtx(ctx, cfg.ReconnectDelay); err != nil {
+				return
+			}
+			continue
+		}
+
+		sess, err := dialSession(ctx, cfg)
+		if err != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			log.Printf("Standby dial failed: %v", err)
+			if sleepErr := sleepCtx(ctx, cfg.ReconnectDelay); sleepErr != nil {
+				return
+			}
+			continue
+		}
+
+		select {
+		case ch <- sess:
+			log.Println("Standby MASQUE session warm")
+		case <-ctx.Done():
+			sess.Close()
+			return
+		default:
+			// Raced with another fill; keep only one.
+			sess.Close()
+		}
+	}
+}
+
+// takeStandby returns the warm session if one is parked, else nil.
+func takeStandby(ch chan *tunnelSession) *tunnelSession {
+	if ch == nil {
+		return nil
+	}
+	select {
+	case sess := <-ch:
+		return sess
+	default:
+		return nil
+	}
+}
+
+// drainStandby closes any parked session. Called when the tunnel stops so a
+// warm session is never left holding a socket.
+func drainStandby(ch chan *tunnelSession) {
+	if ch == nil {
+		return
+	}
+	for {
+		select {
+		case sess := <-ch:
+			sess.Close()
+		default:
+			return
+		}
+	}
+}
+
+// nextFlowTTL jitters the rotation interval by +/-20%.
+//
+// A flow retired on an exact cadence is itself a signature, and synchronized
+// rotation across sessions would put every dial in the same instant. The
+// jitter keeps the pattern irregular without widening the window enough for a
+// sweep to catch the flow.
+func nextFlowTTL(ttl time.Duration) time.Duration {
+	if ttl <= 0 {
+		return 0
+	}
+	spread := int64(ttl / 5)
+	if spread <= 0 {
+		return ttl
+	}
+	return ttl + time.Duration(rand.Int63n(2*spread)-spread)
+}
+
+// rotationShutdownGrace bounds the wait for the retiring pumps on a planned
+// rotation. Unlike a real failure there is nothing to drain - the flow is
+// healthy and we chose the moment - so the wait is only long enough for the
+// IP-connection reader to notice its closed conn.
+const rotationShutdownGrace = 100 * time.Millisecond
+
+// carriedPacket carries one already-read packet across a reconnect.
+//
+// The device pump can be parked in a blocking read when its cycle ends. It
+// wakes holding a real packet it can no longer send, and dropping it costs a
+// retransmit: a multi-second stall for whatever flow owned it. Parking it here
+// lets the next session send it as its first packet instead.
+type carriedPacket struct {
+	mu  sync.Mutex
+	buf []byte
+	n   int
+}
+
+// put parks a packet, reporting false if one is already parked (the caller
+// then owns the buffer and should return it to the pool).
+func (c *carriedPacket) put(buf []byte, n int) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.buf != nil {
+		return false
+	}
+	c.buf, c.n = buf, n
+	return true
+}
+
+// take removes the parked packet, transferring buffer ownership to the caller.
+func (c *carriedPacket) take() ([]byte, int, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.buf == nil {
+		return nil, 0, false
+	}
+	buf, n := c.buf, c.n
+	c.buf, c.n = nil, 0
+	return buf, n, true
+}
+
+// rotationLinger is how long a retired flow keeps being drained into the
+// device after a rotation.
+//
+// Outbound traffic moves to the new session at once, but replies to requests
+// already sent are still coming back on the old one. A dropped TCP segment
+// would only cost a retransmit; a dropped DNS answer costs the resolver's
+// whole timeout, which showed up as 5.2s stalls before this existed.
+const rotationLinger = 3 * time.Second
diff --git a/api/standby_test.go b/api/standby_test.go
new file mode 100644
index 0000000..0613a23
--- /dev/null
+++ b/api/standby_test.go
@@ -0,0 +1,147 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+// Rotation exists to retire a flow before the ISP's sweep does. It may only
+// fire when a warm session is parked, otherwise it would open the very gap it
+// exists to close.
+func TestRotationFiresOnlyWithAWarmStandby(t *testing.T) {
+	ch := make(chan *tunnelSession, 1)
+	ch <- &tunnelSession{}
+	defer drainStandby(ch)
+
+	start := time.Now()
+	err := waitForTunnelEnd(context.Background(), make(chan error), 20*time.Millisecond, ch)
+	if !errors.Is(err, errFlowRotate) {
+		t.Fatalf("expected a rotation, got %v", err)
+	}
+	// The promotion must not cost a dial: the session is already handshaken.
+	if d := time.Since(start); d > 300*time.Millisecond {
+		t.Fatalf("rotation took %v, over the 300ms handover budget", d)
+	}
+}
+
+// With no standby warm, a due rotation must defer rather than tear down the
+// only working flow. This is the guard that keeps aggressive timing safe -
+// the -k 2s experiment showed that faster action without a warm replacement
+// is worse than doing nothing.
+func TestRotationDefersWithoutStandby(t *testing.T) {
+	ch := make(chan *tunnelSession, 1)
+	errChan := make(chan error, 1)
+
+	done := make(chan error, 1)
+	go func() {
+		done <- waitForTunnelEnd(context.Background(), errChan, 10*time.Millisecond, ch)
+	}()
+
+	select {
+	case err := <-done:
+		t.Fatalf("rotated with no standby warm: %v", err)
+	case <-time.After(120 * time.Millisecond):
+	}
+
+	// A real pump error still ends the session while the rotation is deferred.
+	want := errors.New("pump died")
+	errChan <- want
+	select {
+	case got := <-done:
+		if !errors.Is(got, want) {
+			t.Fatalf("got %v, want %v", got, want)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("pump error did not end the wait")
+	}
+}
+
+// A lost flow must still surface immediately when rotation is disabled, so
+// the existing reactive path is unchanged for proxy mode.
+func TestPumpErrorEndsWaitWithoutRotation(t *testing.T) {
+	errChan := make(chan error, 1)
+	want := errors.New("connection closed while reading")
+	errChan <- want
+
+	got := waitForTunnelEnd(context.Background(), errChan, 0, nil)
+	if !errors.Is(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+}
+
+func TestWaitForTunnelEndHonoursContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := waitForTunnelEnd(ctx, make(chan error), 0, nil); !errors.Is(err, context.Canceled) {
+		t.Fatalf("got %v, want context.Canceled", err)
+	}
+}
+
+// Rotating on an exact cadence is itself a signature, and would also line
+// every session's dial up in the same instant.
+func TestFlowTTLIsJittered(t *testing.T) {
+	const ttl = time.Second
+	seen := map[time.Duration]bool{}
+	for i := 0; i < 200; i++ {
+		d := nextFlowTTL(ttl)
+		if d < 800*time.Millisecond || d > 1200*time.Millisecond {
+			t.Fatalf("jittered ttl %v outside +/-20%% of %v", d, ttl)
+		}
+		seen[d] = true
+	}
+	if len(seen) < 10 {
+		t.Fatalf("only %d distinct intervals; jitter is not spreading", len(seen))
+	}
+	if d := nextFlowTTL(0); d != 0 {
+		t.Fatalf("disabled rotation returned %v", d)
+	}
+}
+
+func TestTakeStandbyIsNonBlocking(t *testing.T) {
+	if got := takeStandby(nil); got != nil {
+		t.Fatal("nil channel must yield no session")
+	}
+	ch := make(chan *tunnelSession, 1)
+	if got := takeStandby(ch); got != nil {
+		t.Fatal("empty channel must yield no session")
+	}
+	want := &tunnelSession{}
+	ch <- want
+	if got := takeStandby(ch); got != want {
+		t.Fatal("warm session was not promoted")
+	}
+	if got := takeStandby(ch); got != nil {
+		t.Fatal("a promoted session must not be handed out twice")
+	}
+}
+
+// A packet already read off the device when its cycle ends must survive the
+// handover. Dropping it costs a retransmit, which is a multi-second stall for
+// the flow that owned it - the same fault d5068ff fixed for the wake packet.
+func TestCarriedPacketSurvivesHandover(t *testing.T) {
+	var c carriedPacket
+
+	if _, _, ok := c.take(); ok {
+		t.Fatal("empty carrier yielded a packet")
+	}
+
+	buf := []byte("packet")
+	if !c.put(buf, len(buf)) {
+		t.Fatal("first put was refused")
+	}
+	// Only one packet is ever in flight per cycle; a second must be refused
+	// so the caller can return the buffer to the pool rather than leak it.
+	if c.put([]byte("second"), 6) {
+		t.Fatal("carrier accepted a second packet")
+	}
+
+	got, n, ok := c.take()
+	if !ok || n != len(buf) || string(got[:n]) != "packet" {
+		t.Fatalf("got %q/%d ok=%v, want the parked packet", got, n, ok)
+	}
+	if _, _, ok := c.take(); ok {
+		t.Fatal("packet was handed out twice")
+	}
+}
