diff --git a/cmd/nativetun_darwin.go b/cmd/nativetun_darwin.go
new file mode 100644
index 0000000..1fa1113
--- /dev/null
+++ b/cmd/nativetun_darwin.go
@@ -0,0 +1,72 @@
+//go:build darwin
+
+package cmd
+
+import (
+	"fmt"
+	"os/exec"
+	"strings"
+
+	"github.com/Diniboy1123/usque/api"
+	"github.com/Diniboy1123/usque/config"
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+var longDescription = "Expose Warp as a native TUN device that accepts any IP traffic." +
+	" Requires root. Routing is left to the caller; see --help for the two-halves default route."
+
+// create brings up a utun interface and addresses it.
+//
+// macOS utun is point-to-point: ifconfig needs both the local and the peer
+// address, and BSD route/ifconfig have no netmask form that works here, so the
+// tunnel address is used for both ends. Routing is deliberately NOT set up
+// here - the caller owns it, because tearing routes down correctly needs the
+// original default gateway, which only the supervising app knows.
+func (t *tunDevice) create() (api.TunnelDevice, error) {
+	if t.name == "" {
+		t.name = "utun"
+	}
+	if t.name != "utun" && !strings.HasPrefix(t.name, "utun") {
+		return nil, fmt.Errorf("darwin interface names must start with utun, got %q", t.name)
+	}
+
+	dev, err := tun.CreateTUN(t.name, t.mtu)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create utun (are we root?): %w", err)
+	}
+
+	t.name, err = dev.Name()
+	if err != nil {
+		_ = dev.Close()
+		return nil, err
+	}
+
+	if t.ipv4 {
+		addr := config.AppConfig.IPv4
+		if err := ifconfig(t.name, "inet", addr, addr, "mtu", fmt.Sprint(t.mtu), "up"); err != nil {
+			_ = dev.Close()
+			return nil, fmt.Errorf("failed to set IPv4 address: %w", err)
+		}
+	}
+
+	if t.ipv6 {
+		// IPv6 does not route inside the MASQUE session on the networks this
+		// is used on; addressing it anyway is harmless, but callers are
+		// expected to leave v6 out of the tunnel routes.
+		if err := ifconfig(t.name, "inet6", config.AppConfig.IPv6, "prefixlen", "128", "up"); err != nil {
+			_ = dev.Close()
+			return nil, fmt.Errorf("failed to set IPv6 address: %w", err)
+		}
+	}
+
+	return api.NewNetstackAdapter(dev), nil
+}
+
+func ifconfig(args ...string) error {
+	cmd := exec.Command("/sbin/ifconfig", args...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("ifconfig %s: %w: %s", strings.Join(args, " "), err, strings.TrimSpace(string(out)))
+	}
+	return nil
+}
