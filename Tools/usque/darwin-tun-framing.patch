diff --git a/api/tun_darwin.go b/api/tun_darwin.go
new file mode 100644
index 0000000..14dbd9a
--- /dev/null
+++ b/api/tun_darwin.go
@@ -0,0 +1,80 @@
+//go:build darwin
+
+package api
+
+import (
+	"sync"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// darwinHeader is the 4-byte address-family prefix every utun packet carries.
+//
+// macOS utun is not a bare IP device: each packet on the wire is preceded by
+// the address family. wireguard-go's darwin Read does `bufs[0][offset-4:]` and
+// its Write refuses an offset under 4, so the offset-0 call that works on Linux
+// and Windows panics here with "slice bounds out of range [-4:]" - the tunnel
+// came up, connected, and died on its first packet.
+const darwinHeader = 4
+
+// DarwinTunAdapter presents a utun device as a plain packet device.
+//
+// NetstackAdapter reads and writes at offset 0, which is correct everywhere
+// except darwin. This one keeps the 4 bytes of headroom the OS needs and hands
+// the caller the bare IP packet.
+type DarwinTunAdapter struct {
+	dev  tun.Device
+	pool sync.Pool
+}
+
+// NewDarwinTunAdapter wraps a utun device for MaintainTunnel.
+func NewDarwinTunAdapter(dev tun.Device, mtu int) TunnelDevice {
+	size := mtu + darwinHeader
+	return &DarwinTunAdapter{
+		dev: dev,
+		pool: sync.Pool{New: func() any {
+			b := make([]byte, size)
+			return &b
+		}},
+	}
+}
+
+func (d *DarwinTunAdapter) ReadPacket(buf []byte) (int, error) {
+	scratch := d.pool.Get().(*[]byte)
+	defer d.pool.Put(scratch)
+
+	// Grow rather than truncate: a short scratch would silently clip packets.
+	if len(*scratch) < len(buf)+darwinHeader {
+		grown := make([]byte, len(buf)+darwinHeader)
+		*scratch = grown
+	}
+
+	bufs := [][]byte{*scratch}
+	sizes := []int{0}
+	if _, err := d.dev.Read(bufs, sizes, darwinHeader); err != nil {
+		return 0, err
+	}
+
+	n := sizes[0]
+	if n > len(buf) {
+		n = len(buf)
+	}
+	copy(buf, (*scratch)[darwinHeader:darwinHeader+n])
+	return n, nil
+}
+
+func (d *DarwinTunAdapter) WritePacket(pkt []byte) error {
+	scratch := d.pool.Get().(*[]byte)
+	defer d.pool.Put(scratch)
+
+	if len(*scratch) < len(pkt)+darwinHeader {
+		grown := make([]byte, len(pkt)+darwinHeader)
+		*scratch = grown
+	}
+
+	// The device fills the header itself from the IP version nibble; it only
+	// needs the room reserved ahead of the packet.
+	copy((*scratch)[darwinHeader:], pkt)
+	_, err := d.dev.Write([][]byte{(*scratch)[:darwinHeader+len(pkt)]}, darwinHeader)
+	return err
+}
diff --git a/api/tun_darwin_test.go b/api/tun_darwin_test.go
new file mode 100644
index 0000000..0c155a1
--- /dev/null
+++ b/api/tun_darwin_test.go
@@ -0,0 +1,81 @@
+//go:build darwin
+
+package api
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"testing"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// fakeDarwinTun enforces the contract wireguard-go's darwin device has: the
+// caller must leave 4 bytes of headroom, and the packet starts after it.
+// Anything less is what panicked the real device with "[-4:]".
+type fakeDarwinTun struct {
+	inbound  []byte
+	written  []byte
+	gotWrite bool
+}
+
+func (f *fakeDarwinTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	if offset < 4 {
+		return 0, errors.New("offset under 4 would slice out of range on darwin")
+	}
+	n := copy(bufs[0][offset:], f.inbound)
+	sizes[0] = n
+	return 1, nil
+}
+
+func (f *fakeDarwinTun) Write(bufs [][]byte, offset int) (int, error) {
+	if offset < 4 {
+		return 0, errors.New("short buffer: darwin needs 4 bytes of headroom")
+	}
+	f.written = append([]byte(nil), bufs[0][offset:]...)
+	f.gotWrite = true
+	return 1, nil
+}
+
+func (f *fakeDarwinTun) File() *os.File              { return nil }
+func (f *fakeDarwinTun) Events() <-chan tun.Event    { return nil }
+func (f *fakeDarwinTun) MTU() (int, error)           { return 1280, nil }
+func (f *fakeDarwinTun) Name() (string, error)       { return "utun9", nil }
+func (f *fakeDarwinTun) Close() error                { return nil }
+func (f *fakeDarwinTun) BatchSize() int              { return 1 }
+
+// A packet read off the device must come back as the bare IP packet, with the
+// address-family header stripped.
+func TestDarwinAdapterStripsTheFramingHeader(t *testing.T) {
+	packet := []byte{0x45, 0x00, 0x00, 0x1c, 0xde, 0xad}
+	fake := &fakeDarwinTun{inbound: packet}
+	adapter := NewDarwinTunAdapter(fake, 1280)
+
+	buf := make([]byte, 1280)
+	n, err := adapter.ReadPacket(buf)
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if !bytes.Equal(buf[:n], packet) {
+		t.Fatalf("got % x, want % x", buf[:n], packet)
+	}
+}
+
+// A packet handed to the device must arrive with room for the header in front,
+// or darwin rejects the write outright.
+func TestDarwinAdapterReservesHeadroomOnWrite(t *testing.T) {
+	packet := []byte{0x45, 0x00, 0x00, 0x1c, 0xbe, 0xef}
+	fake := &fakeDarwinTun{}
+	adapter := NewDarwinTunAdapter(fake, 1280)
+
+	if err := adapter.WritePacket(packet); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if !fake.gotWrite {
+		t.Fatal("device never saw the packet")
+	}
+	if !bytes.Equal(fake.written, packet) {
+		t.Fatalf("device got % x, want % x", fake.written, packet)
+	}
+}
diff --git a/cmd/nativetun_darwin.go b/cmd/nativetun_darwin.go
index 1fa1113..2dc036b 100644
--- a/cmd/nativetun_darwin.go
+++ b/cmd/nativetun_darwin.go
@@ -59,7 +59,9 @@ func (t *tunDevice) create() (api.TunnelDevice, error) {
 		}
 	}
 
-	return api.NewNetstackAdapter(dev), nil
+	// Not NewNetstackAdapter: that reads and writes at offset 0, which panics
+	// on darwin's 4-byte utun framing.
+	return api.NewDarwinTunAdapter(dev, t.mtu), nil
 }
 
 func ifconfig(args ...string) error {
