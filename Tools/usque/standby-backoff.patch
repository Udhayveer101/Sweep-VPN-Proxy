 		}
+		cycleStart := time.Now()
 
 		// A warm session means there is nothing to wait for: promoting it is
 		// the whole point, and the idle wait below would park us in a
@@ -449,8 +450,14 @@ func MaintainTunnel(ctx context.Context, cfg MaintainTunnelConfig) {
 
 		// A warm standby is the whole reason a kill can be invisible: waiting
 		// out the reconnect delay before promoting it would spend the gap we
-		// just paid to avoid.
+		// just paid to avoid. Only the full delay is skipped, not every brake -
+		// see minCycleInterval.
 		if len(standbyCh) > 0 {
+			if rest := minCycleInterval - time.Since(cycleStart); rest > 0 {
+				if sleepErr := sleepCtx(ctx, rest); sleepErr != nil {
+					return
+				}
+			}
 			continue
 		}
