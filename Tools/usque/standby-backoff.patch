diff --git a/api/standby_backoff_test.go b/api/standby_backoff_test.go
new file mode 100644
index 0000000..fee6c5a
--- /dev/null
+++ b/api/standby_backoff_test.go
@@ -0,0 +1,36 @@
+package api
+
+import "testing"
+
+// The brake this puts back: without it, fillStandby re-dialled a down path at
+// ReconnectDelay (1s) forever, and each failure wrote a log line that the iOS
+// side journals synchronously.
+func TestStandbyDialBackoffClimbsAndCaps(t *testing.T) {
+	if standbyDialBackoff[0] > standbyDialBackoff[len(standbyDialBackoff)-1] {
+		t.Fatal("backoff must climb")
+	}
+	for i := 1; i < len(standbyDialBackoff); i++ {
+		if standbyDialBackoff[i] <= standbyDialBackoff[i-1] {
+			t.Fatalf("step %d (%s) does not climb past %s", i, standbyDialBackoff[i], standbyDialBackoff[i-1])
+		}
+	}
+	// Past the end the index is clamped, so a long outage settles rather than
+	// panicking or retrying forever at 1Hz.
+	last := len(standbyDialBackoff) - 1
+	for _, fails := range []int{last, last + 1, 1000} {
+		if got := standbyDialBackoff[min(fails, last)]; got != standbyDialBackoff[last] {
+			t.Fatalf("fails=%d gave %s, want the %s cap", fails, got, standbyDialBackoff[last])
+		}
+	}
+}
+
+// A promotion must stay effectively instant — the standby exists to make a kill
+// invisible, and waiting the full reconnect delay would spend that gap.
+func TestMinCycleIntervalIsAFloorNotADelay(t *testing.T) {
+	if minCycleInterval <= 0 {
+		t.Fatal("no floor at all: churn is unbounded again")
+	}
+	if minCycleInterval >= standbyDialBackoff[0] {
+		t.Fatalf("floor %s is as slow as a reconnect delay; promotion is no longer instant", minCycleInterval)
+	}
+}
