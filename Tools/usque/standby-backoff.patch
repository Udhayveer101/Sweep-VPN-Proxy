index ba3c551..5b5c9e1 100644
--- a/api/tunnel.go
+++ b/api/tunnel.go
@@ -263,6 +263,7 @@ func MaintainTunnel(ctx context.Context, cfg MaintainTunnelConfig) {
 		if ctx.Err() != nil {
