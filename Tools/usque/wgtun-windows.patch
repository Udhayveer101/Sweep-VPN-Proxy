diff --git a/cmd/wgtun_tun_darwin.go b/cmd/wgtun_tun_darwin.go
new file mode 100644
index 0000000..e34c1c0
--- /dev/null
+++ b/cmd/wgtun_tun_darwin.go
@@ -0,0 +1,28 @@
+//go:build darwin
+
+package cmd
+
+import (
+	"fmt"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// wgCreateTUN brings up the device wgtun runs on, with the same
+// point-to-point addressing as nativetun; see tunDevice.create.
+func wgCreateTUN(addr string, mtu int) (tun.Device, string, error) {
+	dev, err := tun.CreateTUN("utun", mtu)
+	if err != nil {
+		return nil, "", err
+	}
+	name, err := dev.Name()
+	if err != nil {
+		_ = dev.Close()
+		return nil, "", err
+	}
+	if err := ifconfig(name, "inet", addr, addr, "mtu", fmt.Sprint(mtu), "up"); err != nil {
+		_ = dev.Close()
+		return nil, "", fmt.Errorf("failed to set IPv4 address: %w", err)
+	}
+	return dev, name, nil
+}
