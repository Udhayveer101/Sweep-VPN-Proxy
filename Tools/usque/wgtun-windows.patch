diff --git a/api/hopprobe.go b/api/hopprobe.go
index c1498fa..8cca557 100644
--- a/api/hopprobe.go
+++ b/api/hopprobe.go
@@ -48,6 +48,10 @@ func (h *hopTracker) observe(hop string) bool {
 // event; a second change before the first is consumed is the same news.
 func watchHop(ctx context.Context, endpoint net.IP, interval time.Duration) <-chan struct{} {
 	changed := make(chan struct{}, 1)
+	if hopOnce != nil {
+		go watchHopWith(ctx, endpoint, interval, hopOnce, changed)
+		return changed
+	}
 	// "udp4" is the unprivileged ICMP datagram socket, so this works for the
 	// socks proxy as well as the root nativetun.
 	conn, err := icmp.ListenPacket("udp4", "0.0.0.0")
@@ -136,3 +140,37 @@ func isOwnProbe(quoted []byte, endpoint net.IP, id, seq int) bool {
 		int(binary.BigEndian.Uint16(echo[4:6])) == id &&
 		int(binary.BigEndian.Uint16(echo[6:8])) == seq
 }
+
+// hopOnce, where a platform sets it, sends one probe and reports the router
+// that answered, or "" when none did within the timeout. Windows has no
+// unprivileged ICMP socket, and its firewall drops the Time Exceeded replies a
+// raw socket would wait for; it has an API for exactly this instead.
+var hopOnce func(endpoint net.IP, timeout time.Duration) string
+
+// watchHopWith is watchHop's loop over hopOnce.
+func watchHopWith(ctx context.Context, endpoint net.IP, interval time.Duration,
+	probe func(net.IP, time.Duration) string, changed chan<- struct{}) {
+	var tracker hopTracker
+	for ctx.Err() == nil {
+		start := time.Now()
+		if hop := probe(endpoint, interval); hop != "" {
+			was := tracker.last
+			if was == "" {
+				log.Printf("Hop %d is %s", hopProbeTTL, hop)
+			}
+			if tracker.observe(hop) {
+				log.Printf("Hop %d changed: %s -> %s", hopProbeTTL, was, hop)
+				select {
+				case changed <- struct{}{}:
+				default:
+				}
+			}
+		}
+		// A probe that was answered at once must not turn into a flood.
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(time.Until(start.Add(interval))):
+		}
+	}
+}
