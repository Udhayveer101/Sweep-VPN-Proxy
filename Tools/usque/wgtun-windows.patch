+//go:build windows
+
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/Diniboy1123/usque/internal"
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+// wgCreateTUN brings up the wintun device wgtun runs on. Same name and
+// addressing as nativetun's (tunDevice.create), so whatever routes into one
+// routes into the other: only one of the two runs at a time.
+func wgCreateTUN(addr string, mtu int) (tun.Device, string, error) {
+	dev, err := tun.CreateTUN("usque", mtu)
+	if err != nil {
+		return nil, "", err
+	}
+	name, err := dev.Name()
+	if err != nil {
+		_ = dev.Close()
+		return nil, "", err
+	}
+	if err := internal.SetIPv4Address(name, addr, "255.255.255.255"); err != nil {
+		_ = dev.Close()
+		return nil, "", fmt.Errorf("failed to set IPv4 address: %v", err)
+	}
+	if err := internal.SetIPv4MTU(name, mtu); err != nil {
+		_ = dev.Close()
+		return nil, "", fmt.Errorf("failed to set IPv4 MTU: %v", err)
+	}
+	return dev, name, nil
+}
