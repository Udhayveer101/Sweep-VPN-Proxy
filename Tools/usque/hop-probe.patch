 api/hopprobe_test.go | 34 ++++++++++++++++
 api/standby_test.go  |  8 ++--
 api/tunnel.go        | 42 +++++++++++++++++--
 cmd/nativetun.go     |  8 ++++
 cmd/socks.go         |  8 ++++
 6 files changed, 190 insertions(+), 7 deletions(-)
 create mode 100644 api/hopprobe.go
