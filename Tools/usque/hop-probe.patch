diff --git a/api/hopprobe.go b/api/hopprobe.go
new file mode 100644
index 0000000..db5a727
--- /dev/null
+++ b/api/hopprobe.go
@@ -0,0 +1,97 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"log"
+	"net"
+	"os"
+	"time"
+
+	"golang.org/x/net/icmp"
+	"golang.org/x/net/ipv4"
+)
+
+// errHopChanged ends a MASQUE session whose path just moved.
+//
+// On the target network the LAN gateway moves traffic between WAN uplinks
+// (measured 2026-10-08: the second hop alternates between three addresses and
+// every tunnel loss follows a change within seconds). The new uplink is a new
+// public source address, so Cloudflare drops the established TCP flow without a
+// RST and the only signal left is our own PING timeout, 8s later. The second
+// hop changes the moment the uplink does, so watching it finds the kill in
+// about a second instead.
+var errHopChanged = errors.New("path to the endpoint changed")
+
+// hopProbeTTL is how far the probe travels: past the LAN gateway (hop 1) to
+// the first router of whichever uplink is in use.
+// ponytail: fixed at 2, which is right for one NAT gateway. A network with a
+// second private hop needs this raised; make it a flag when one is seen.
+const hopProbeTTL = 2
+
+// hopTracker turns a stream of hop observations into change events. The first
+// observation only sets the baseline.
+type hopTracker struct {
+	last string
+}
+
+func (h *hopTracker) observe(hop string) bool {
+	changed := h.last != "" && hop != h.last
+	h.last = hop
+	return changed
+}
+
+// watchHop sends a TTL-limited echo towards endpoint every interval and
+// signals on the returned channel when the router that answers changes. A
+// lost probe carries no information and is ignored. The channel holds one
+// event; a second change before the first is consumed is the same news.
+func watchHop(ctx context.Context, endpoint net.IP, interval time.Duration) <-chan struct{} {
+	changed := make(chan struct{}, 1)
+	// "udp4" is the unprivileged ICMP datagram socket, so this works for the
+	// socks proxy as well as the root nativetun.
+	conn, err := icmp.ListenPacket("udp4", "0.0.0.0")
+	if err != nil {
+		log.Printf("Hop probe disabled: %v", err)
+		return changed
+	}
+	if err := conn.IPv4PacketConn().SetTTL(hopProbeTTL); err != nil {
+		log.Printf("Hop probe disabled: %v", err)
+		_ = conn.Close()
+		return changed
+	}
+
+	go func() {
+		defer conn.Close()
+		var tracker hopTracker
+		dst := &net.UDPAddr{IP: endpoint}
+		buf := make([]byte, 1500)
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		for seq := 0; ; seq++ {
+			msg := icmp.Message{Type: ipv4.ICMPTypeEcho, Body: &icmp.Echo{ID: os.Getpid() & 0xffff, Seq: seq & 0xffff, Data: []byte("usquehop")}}
+			if b, err := msg.Marshal(nil); err == nil {
+				_, _ = conn.WriteTo(b, dst)
+			}
+			_ = conn.SetReadDeadline(time.Now().Add(interval))
+			if n, peer, err := conn.ReadFrom(buf); err == nil {
+				if m, err := icmp.ParseMessage(1, buf[:n]); err == nil && m.Type == ipv4.ICMPTypeTimeExceeded {
+					hop := peer.(*net.UDPAddr).IP.String()
+					was := tracker.last
+					if tracker.observe(hop) {
+						log.Printf("Hop %d changed: %s -> %s", hopProbeTTL, was, hop)
+						select {
+						case changed <- struct{}{}:
+						default:
+						}
+					}
+				}
+			}
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+			}
+		}
+	}()
+	return changed
+}
