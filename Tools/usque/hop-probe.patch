From e1c1a84a643f36d35f509724b7c623aaac569109 Mon Sep 17 00:00:00 2001
From: Udhayveer Singh <udhayveersingh@Udhayveer.local>
Date: Thu, 8 Oct 2026 23:27:28 +0530
Subject: [PATCH 2/2] Hop probe: answer only to its own echo, drain the socket,
 and skip the pump grace

The probe took any Time Exceeded on its socket as its own reply and read one
message per tick. A traceroute on the same machine ended a healthy session
every second or two, and its queued replies made real switches arrive up to
16s late. Match the quoted echo's destination, identifier and sequence, and
read until the next probe is due.

After a hop change the flow is dead, so the 2s pump shutdown grace was the
whole redial (the dial itself is ~60ms). Skip it on that path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 api/hopprobe.go      | 73 ++++++++++++++++++++++++++++++++++----------
 api/hopprobe_test.go | 43 ++++++++++++++++++++++++++
 api/tunnel.go        | 31 +++++++++++++------
 3 files changed, 122 insertions(+), 25 deletions(-)

diff --git a/api/hopprobe.go b/api/hopprobe.go
index db5a727..c1498fa 100644
--- a/api/hopprobe.go
+++ b/api/hopprobe.go
@@ -2,6 +2,7 @@ package api
 
 import (
 	"context"
+	"encoding/binary"
 	"errors"
 	"log"
 	"net"
@@ -65,33 +66,73 @@ func watchHop(ctx context.Context, endpoint net.IP, interval time.Duration) <-ch
 		var tracker hopTracker
 		dst := &net.UDPAddr{IP: endpoint}
 		buf := make([]byte, 1500)
-		ticker := time.NewTicker(interval)
-		defer ticker.Stop()
-		for seq := 0; ; seq++ {
-			msg := icmp.Message{Type: ipv4.ICMPTypeEcho, Body: &icmp.Echo{ID: os.Getpid() & 0xffff, Seq: seq & 0xffff, Data: []byte("usquehop")}}
+		id := os.Getpid() & 0xffff
+		for seq := 0; ctx.Err() == nil; seq = (seq + 1) & 0xffff {
+			msg := icmp.Message{Type: ipv4.ICMPTypeEcho, Body: &icmp.Echo{ID: id, Seq: seq, Data: []byte("usquehop")}}
 			if b, err := msg.Marshal(nil); err == nil {
 				_, _ = conn.WriteTo(b, dst)
 			}
-			_ = conn.SetReadDeadline(time.Now().Add(interval))
-			if n, peer, err := conn.ReadFrom(buf); err == nil {
-				if m, err := icmp.ParseMessage(1, buf[:n]); err == nil && m.Type == ipv4.ICMPTypeTimeExceeded {
-					hop := peer.(*net.UDPAddr).IP.String()
-					was := tracker.last
-					if tracker.observe(hop) {
-						log.Printf("Hop %d changed: %s -> %s", hopProbeTTL, was, hop)
-						select {
-						case changed <- struct{}{}:
-						default:
-						}
+			// Read until the next probe is due, not once: the socket also
+			// receives the errors other programs' packets drew (a traceroute
+			// above all), and one read per probe let those queue up until
+			// the answers we acted on were many seconds old.
+			deadline := time.Now().Add(interval)
+			_ = conn.SetReadDeadline(deadline)
+			for {
+				n, peer, err := conn.ReadFrom(buf)
+				if err != nil {
+					break
+				}
+				m, err := icmp.ParseMessage(1, buf[:n])
+				if err != nil || m.Type != ipv4.ICMPTypeTimeExceeded {
+					continue
+				}
+				te, ok := m.Body.(*icmp.TimeExceeded)
+				if !ok || !isOwnProbe(te.Data, endpoint, id, seq) {
+					continue
+				}
+				hop := peer.(*net.UDPAddr).IP.String()
+				was := tracker.last
+				if was == "" {
+					log.Printf("Hop %d is %s", hopProbeTTL, hop)
+				}
+				if tracker.observe(hop) {
+					log.Printf("Hop %d changed: %s -> %s", hopProbeTTL, was, hop)
+					select {
+					case changed <- struct{}{}:
+					default:
 					}
 				}
 			}
+			// A read that failed early (closed socket) must not spin.
 			select {
 			case <-ctx.Done():
 				return
-			case <-ticker.C:
+			case <-time.After(time.Until(deadline)):
 			}
 		}
 	}()
 	return changed
 }
+
+// isOwnProbe reports whether the datagram quoted in a Time Exceeded message is
+// the echo this probe sent: same destination, identifier and sequence number.
+// Without the check any expired packet on the machine reads as an answer. A
+// traceroute's first-hop reply is a different router than ours, so it looked
+// like a path change and ended a healthy session every second or two.
+func isOwnProbe(quoted []byte, endpoint net.IP, id, seq int) bool {
+	if len(quoted) < ipv4.HeaderLen {
+		return false
+	}
+	hlen := int(quoted[0]&0x0f) * 4
+	if quoted[0]>>4 != 4 || hlen < ipv4.HeaderLen || len(quoted) < hlen+8 {
+		return false
+	}
+	if !net.IP(quoted[16:20]).Equal(endpoint) || quoted[9] != 1 {
+		return false
+	}
+	echo := quoted[hlen:]
+	return echo[0] == byte(ipv4.ICMPTypeEcho) &&
+		int(binary.BigEndian.Uint16(echo[4:6])) == id &&
+		int(binary.BigEndian.Uint16(echo[6:8])) == seq
+}
diff --git a/api/hopprobe_test.go b/api/hopprobe_test.go
index 6d83b64..8db39a1 100644
--- a/api/hopprobe_test.go
+++ b/api/hopprobe_test.go
@@ -3,6 +3,7 @@ package api
 import (
 	"context"
 	"errors"
+	"net"
 	"testing"
 )
 
@@ -32,3 +33,45 @@ func TestHopChangeEndsTheSession(t *testing.T) {
 		t.Fatalf("err = %v, want errHopChanged", err)
 	}
 }
+
+// quotedEcho is what a router quotes back in Time Exceeded: the IPv4 header of
+// the expired packet and its first eight bytes.
+func quotedEcho(dst net.IP, proto byte, id, seq int) []byte {
+	b := make([]byte, 28)
+	b[0] = 0x45
+	b[9] = proto
+	copy(b[16:20], dst.To4())
+	b[20] = 8 // echo request
+	b[24], b[25] = byte(id>>8), byte(id)
+	b[26], b[27] = byte(seq>>8), byte(seq)
+	return b
+}
+
+// A traceroute running beside the probe made it end a healthy session every
+// second or two (2026-10-08): its first-hop replies arrived on the same socket.
+func TestProbeIgnoresOtherProgramsReplies(t *testing.T) {
+	ep := net.IPv4(162, 159, 198, 2)
+	if !isOwnProbe(quotedEcho(ep, 1, 0x1234, 7), ep, 0x1234, 7) {
+		t.Fatal("own probe rejected")
+	}
+	for name, q := range map[string][]byte{
+		"other identifier":  quotedEcho(ep, 1, 0x9999, 7),
+		"stale sequence":    quotedEcho(ep, 1, 0x1234, 6),
+		"other destination": quotedEcho(net.IPv4(1, 1, 1, 1), 1, 0x1234, 7),
+		"udp, not icmp":     quotedEcho(ep, 17, 0x1234, 7),
+		"truncated":         quotedEcho(ep, 1, 0x1234, 7)[:24],
+	} {
+		if isOwnProbe(q, ep, 0x1234, 7) {
+			t.Fatalf("%s accepted as our probe", name)
+		}
+	}
+}
+
+func TestNoShutdownGraceAfterAHopChange(t *testing.T) {
+	if g := shutdownGrace(errHopChanged); g != 0 {
+		t.Fatalf("grace after a hop change = %s, want 0", g)
+	}
+	if g := shutdownGrace(errors.New("http2: client connection lost")); g != pumpShutdownGrace {
+		t.Fatalf("grace after a pump error = %s, want %s", g, pumpShutdownGrace)
+	}
+}
