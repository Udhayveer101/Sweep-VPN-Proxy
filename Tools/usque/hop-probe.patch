@@ -0,0 +1,34 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestHopTrackerReportsOnlyChanges(t *testing.T) {
+	var h hopTracker
+	steps := []struct {
+		hop  string
+		want bool
+	}{
+		{"103.30.140.65", false}, // baseline, not a change
+		{"103.30.140.65", false},
+		{"103.225.42.209", true},
+		{"103.225.42.209", false},
+		{"103.30.140.65", true}, // flapping back is a change too
+	}
+	for i, s := range steps {
+		if got := h.observe(s.hop); got != s.want {
+			t.Fatalf("step %d (%s): changed = %v, want %v", i, s.hop, got, s.want)
+		}
+	}
+}
+
+func TestHopChangeEndsTheSession(t *testing.T) {
+	hop := make(chan struct{}, 1)
+	hop <- struct{}{}
+	if err := waitForTunnelEnd(context.Background(), make(chan error), 0, nil, hop); !errors.Is(err, errHopChanged) {
+		t.Fatalf("err = %v, want errHopChanged", err)
+	}
+}
