[Unit]
Description=Sweep VPN transport bridge (TLS/QUIC/TCP -> WireGuard)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sweepbridge \
  --wireguard 127.0.0.1:51820 \
  --tls 0.0.0.0:443 --quic 0.0.0.0:443 --tcp 0.0.0.0:8080 \
  --cert /etc/sweep/tls/fullchain.pem --key /etc/sweep/tls/privkey.pem
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/etc/sweep/tls
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
